# Modified version of the 'doctrine_core_tenets' group from 'A Game of Thrones' total conversion mod (2962333032)
# As the Faith and the Faith Creation window are wide enough for displaying 7 tenets in a row, I decided to set the maximum for tenets to pick up to 21.
# Therefore 18 Empty Core Tenets are added

doctrine_core_tenets = {
	category = "core_tenets"

	# Hide vanilla tenet row when creating an Old Blood faith. Valyrian uses doctrine_jen_valyrian_tenets only.
	is_available_on_create = {
		NOT = { religion_tag = jen_valyrian_religion }
	}

	# Enhanced from 3 to 21 by Holger
	number_of_picks = 21

